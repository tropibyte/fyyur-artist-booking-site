# Copy to `.env` and fill in for your machine: `cp .env.example .env`
FLASK_APP=app.py
FLASK_DEBUG=1
FYYUR_CONFIG=development

# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://fyyur:<password>@127.0.0.1:5432/fyyur
TEST_DATABASE_URL=postgresql://fyyur:<password>@127.0.0.1:5432/fyyur_test

SECRET_KEY=change-me
# Set to 1 to echo every generated SQL statement to the console.
FYYUR_SQL_ECHO=0
